{
  "claims": [
    {"id": "jar pin in the README equals the tag being released", "file": "README.md", "regex": "lintChecks\\(files\\(\"[^\"]*android-target-lint-([0-9.]+)\\.jar", "expect": {"env": "RELEASE_TAG", "regex": "^v([0-9.]+)$"}},
    {"id": "Maven pin in the README equals the tag being released", "file": "README.md", "regex": "android-target-lint:([0-9.]+)\"", "expect": {"env": "RELEASE_TAG", "regex": "^v([0-9.]+)$"}},
    {"id": "newest CHANGELOG version equals the tag being released", "file": "CHANGELOG.md", "regex": "^# Changelog\\s+## ([0-9.]+) ", "expect": {"env": "RELEASE_TAG", "regex": "^v([0-9.]+)$"}}
  ]
}
